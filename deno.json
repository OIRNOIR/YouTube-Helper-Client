{
	"nodeModulesDir": "auto",
	"tasks": {
		"lint": "deno x @biomejs/biome check . --write && deno lint",
		"style:check": "deno x @biomejs/biome ci . && deno lint",
		"typecheck": "deno check"
	},
	"imports": {
		"@biomejs/biome": "npm:@biomejs/biome@2.6.6",
		"ansi-regex": "npm:ansi-regex@6.5.0",
		"emoji-regex": "npm:emoji-regex@11.0.0",
		"string-width": "npm:string-width@8.3.0"
	},
	"permissions": {
		"default": {
			"read": true,
			"write": true,
			"env": true,
			"net": true,
			"run": true,
			"sys": true
		}
	},
	"minimumDependencyAge": "P7D"
}
